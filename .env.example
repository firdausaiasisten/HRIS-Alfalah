# Optional. If unset, src/lib/supabaseApi.js falls back to the values it
# has always shipped with (the anon key is safe to expose client-side --
# real access control is enforced by Postgres Row Level Security, see
# database/rls_policies.sql).
#
# Set these to point the app at a different Supabase project (e.g. a
# staging project) without touching source. Copy this file to `.env.local`
# for local dev, or set the same two keys in the Vercel project's
# Settings -> Environment Variables for deployed builds.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
